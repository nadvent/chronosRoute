# ==============================================================================
# ChronosRoute Environment Variables
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL 18 + PostGIS 3.6)
POSTGRES_DB=chronos_db
POSTGRES_USER=chronos_admin
POSTGRES_PASSWORD=chronos_secret_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chronos_admin:chronos_secret_password@localhost:5432/chronos_db
DATABASE_ASYNC_URL=postgresql+asyncpg://chronos_admin:chronos_secret_password@localhost:5432/chronos_db

# Redis Streams & In-Memory Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_GPS_STREAM_KEY=courier:telemetry:stream
REDIS_GPS_CONSUMER_GROUP=orchestrator_fleet_group

# C++20 VRP Solver gRPC Service
SOLVER_GRPC_HOST=localhost
SOLVER_GRPC_PORT=50051
SOLVER_NUM_THREADS=8
SOLVER_DEADLINE_MS=500

# External APIs (No paid keys required)
OSRM_BACKEND_URL=http://localhost:5000
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Python Ingestion Service
INGESTION_HTTP_PORT=8000
INGESTION_CONCURRENCY_LIMIT=16
INGESTION_RATE_LIMIT_TOKENS=60
INGESTION_CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.20

# Java Orchestrator Service
ORCHESTRATOR_HTTP_PORT=8080
SPRING_THREADS_VIRTUAL_ENABLED=true
HIKARI_MAX_POOL_SIZE=30
HIKARI_MIN_IDLE=10
